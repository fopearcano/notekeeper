# Notekeeper environment variables
# ----------------------------------
# Copy this file to ``.env`` (or export the vars in your shell profile)
# and fill in the keys you actually use. Notekeeper resolves API keys
# at request time from the variable named in each provider's
# ``api_key_env`` config field — never from this file directly. The
# config file ships only the variable name; the value stays out of
# source control.

# OpenAI — used by [openai_audio] (whisper-1) and [openai] (chat).
OPENAI_API_KEY=

# Anthropic — used by [anthropic] (Messages API).
ANTHROPIC_API_KEY=

# LM Studio servers usually accept any non-empty token. The default
# ``[lmstudio].api_key = "lm-studio"`` works out of the box; if your
# server enforces a real bearer token, put it here and reference it
# from your config file instead of the inline placeholder.
# LMSTUDIO_API_KEY=
